# Template for local settings.
# 1. Copy this file and name the copy .env
# 2. Put your real OpenAI key on the OPENAI_API_KEY line.
# 3. Do not share .env and do not commit it.
#
# Paste your key immediately after the equals sign. No quotes and no spaces.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# How long one page download may take, in seconds.
FETCH_TIMEOUT_SECONDS=10

# Largest decoded page the reader will keep, in bytes.
MAX_RESPONSE_BYTES=1000000

# Most article text kept for a later study step, in characters.
MAX_SOURCE_CHARS=60000

# Shortest article text that counts as readable, in characters.
MIN_SOURCE_CHARS=400

# Local database file. This file stays on your computer.
DATABASE_PATH=data/studymaster.db

# How long one model call may take, in seconds.
OPENAI_TIMEOUT_SECONDS=60

# Low temperature keeps the writing close to the source page.
OPENAI_TEMPERATURE=0.2
